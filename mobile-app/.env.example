# Copy to .env (gitignored). EXPO_PUBLIC_* values are inlined into the app bundle: no secrets here.
EXPO_PUBLIC_CHAIN_ID=143
EXPO_PUBLIC_RPC_URL=https://rpc.monad.xyz
EXPO_PUBLIC_FALLBACK_RPC=https://rpc.monad.xyz
EXPO_PUBLIC_PERPL_API_URL=https://app.perpl.xyz/api
EXPO_PUBLIC_PERPL_WS_URL=wss://app.perpl.xyz
EXPO_PUBLIC_PERPL_EXCHANGE=0x34B6552d57a35a1D042CcAe1951BD1C370112a6F
EXPO_PUBLIC_AUSD=0x00000000eFE302BEAA2b3e6e1b18d08D69a9012a
# Passkey relying-party domain (plan D10). Must serve /.well-known files. Decide before creating any passkey.
EXPO_PUBLIC_RP_ID=
# Envio GraphQL endpoint for the Perpl indexer (indexer/). Leave empty to use the local journal only.
EXPO_PUBLIC_ENVIO_URL=
EXPO_PUBLIC_WEB_URL=https://pocket-app-web.vercel.app
